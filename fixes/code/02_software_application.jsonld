{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "IncuBrix Creator Studio",
  "url": "https://app.incubrix.com/",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Web",
  "description": "Creator Studio finds trending topics, cuts long videos into clips, adds captions, and publishes to multiple platforms from one screen.",
  "publisher": { "@id": "https://incubrix.com/#organization" },
  "offers": [
    { "@type": "Offer", "name": "Free",    "price": "0",   "priceCurrency": "USD", "description": "300 credits per month" },
    { "@type": "Offer", "name": "Starter", "price": "10",  "priceCurrency": "USD", "description": "1,000 credits per month" },
    { "@type": "Offer", "name": "Essential","price": "20", "priceCurrency": "USD", "description": "2,000 credits per month" },
    { "@type": "Offer", "name": "Growth",  "price": "50",  "priceCurrency": "USD", "description": "5,000 credits per month" },
    { "@type": "Offer", "name": "Scale",   "price": "100", "priceCurrency": "USD", "description": "10,000 credits per month" },
    { "@type": "Offer", "name": "Pro",     "price": "250", "priceCurrency": "USD", "description": "25,000 credits per month" }
  ]
}
